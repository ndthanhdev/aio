# Copy to etc/docker/.env to override the defaults. Docker Compose reads that
# file automatically; variables set in the shell take precedence over it.

# Host port for the site dev server.
SITE_PORT=

# UID/GID of the container's `dev` user. Match your host user (`id -u`, `id -g`)
# so files written into the checkout keep your ownership.
UID=1000
GID=1000
