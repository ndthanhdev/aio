# Copy to etc/docker/.env to override the defaults. Docker Compose reads that
# file automatically; variables set in the shell take precedence over it.

# Services publish a host port built as A BB CC, where CC is the service code
# (site 01). In the main checkout with the defaults, the site is on 10001.

# A: a digit from 1 to 6. Empty means 1.
PORT_PREFIX=

# BB: two digits that keep worktrees apart; also names the compose project
# (aio-BB). Empty means 00 in the main checkout and a code from 01 to 99,
# derived from the path, in a linked worktree. Set it if two worktrees collide.
PORT_WORKTREE=

# UID/GID of the container's `dev` user. Match your host user (`id -u`, `id -g`)
# so files written into the checkout keep your ownership.
UID=1000
GID=1000
